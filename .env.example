# ---------------------------------------------------------------------------
# HomeTour configuration. Every value is optional for local development.
# Copy to .env.local and adjust.
# ---------------------------------------------------------------------------

# Public base URL (used for share links, QR codes, embeds, sitemaps, OG tags).
# On Vercel it defaults to the production domain; locally to http://localhost:3000.
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database: a local SQLite file by default; a Turso/libSQL URL in production.
# Vercel's Turso integration sets TURSO_DATABASE_URL / TURSO_AUTH_TOKEN, which work as-is.
# DATABASE_URL=file:./.data/hometour.db
# DATABASE_AUTH_TOKEN=

# Media storage: "local" (./.data/storage), "blob" (Vercel Blob) or "s3" (any S3-compatible
# bucket, e.g. Cloudflare R2). When unset, a connected Vercel Blob store (BLOB_READ_WRITE_TOKEN)
# is used automatically, otherwise local disk.
# STORAGE_DRIVER=local
# STORAGE_DIR=./.data/storage
# BLOB_READ_WRITE_TOKEN=          # set by Vercel when a Blob store is connected to the project
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://media.example.com   # CDN/public bucket URL; otherwise media is proxied via /files
# S3_FORCE_PATH_STYLE=false

# AI (optional — the product works fully without it).
# With a key set, photo sorting + descriptions use Claude. AI_PROVIDER=mock gives
# deterministic fake results for local development and tests.
# ANTHROPIC_API_KEY=
# AI_PROVIDER=anthropic          # anthropic | mock | off
# AI_CLASSIFY_MODEL=claude-haiku-4-5
# AI_DESCRIBE_MODEL=claude-opus-5-5
# AI_MAX_SPEND_PER_PROPERTY_USD=1

# Largest request body the host accepts. Images above it are re-encoded in the browser before
# upload. Defaults to 4.2 MB on Vercel (functions cap requests at 4.5 MB); unlimited elsewhere.
# UPLOAD_BODY_LIMIT_BYTES=

# Plans: while false (early access) every feature is unlocked for everyone.
BILLING_ENABLED=false

# Comma-separated emails that can open /admin (product funnel + AI spend).
# ADMIN_EMAILS=you@example.com
